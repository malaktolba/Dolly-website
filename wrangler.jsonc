{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dolly",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Placeholder ids below work for local development.
  // Before the first deploy, replace them with the ids printed by the commands in README.md.
  "d1_databases": [
    {
      // Orders, products, stock, shipping
      "binding": "DB",
      "database_name": "dolly-orders",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    {
      // Page-cache bookkeeping for OpenNext (same database, separate table)
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "dolly-orders",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    // Uploaded product photos
    { "binding": "MEDIA", "id": "00000000000000000000000000000001" },
    // Cached shop pages
    { "binding": "NEXT_INC_CACHE_KV", "id": "00000000000000000000000000000002" }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "dolly" }],
  "vars": {
    "SITE_URL": "https://dolly-shop.com",
    "NOTIFY_EMAIL": "dollyy825@gmail.com"
  }
}
